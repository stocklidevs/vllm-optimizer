{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vLLM Optimizer Experiment Definition",
  "type": "object",
  "required": ["experiment_id", "objective", "model", "workload", "parameter_space", "target"],
  "properties": {
    "experiment_id": { "type": "string", "minLength": 1 },
    "objective": {
      "type": "object",
      "required": ["family", "primary_metric", "direction"],
      "properties": {
        "family": {
          "type": "string",
          "enum": [
            "throughput",
            "latency",
            "memory",
            "tool-calling",
            "structured-output",
            "long-context",
            "stability",
            "balanced"
          ]
        },
        "primary_metric": { "type": "string", "minLength": 1 },
        "direction": { "type": "string", "enum": ["maximize", "minimize"] },
        "constraints": { "type": "object" },
        "tie_breakers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["metric", "direction"],
            "properties": {
              "metric": { "type": "string", "minLength": 1 },
              "direction": { "type": "string", "enum": ["maximize", "minimize"] }
            }
          }
        }
      }
    },
    "model": {
      "type": "object",
      "required": ["id", "vllm_version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "path_label": { "type": "string" },
        "vllm_version": { "type": "string", "minLength": 1 },
        "tokenizer": { "type": "string" }
      }
    },
    "workload": {
      "type": "object",
      "required": ["prompt_corpus_id", "request_mix", "concurrency", "seeds"],
      "properties": {
        "prompt_corpus_id": { "type": "string", "minLength": 1 },
        "request_mix": { "type": "string", "minLength": 1 },
        "concurrency": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 },
          "minItems": 1
        },
        "seeds": {
          "type": "array",
          "items": { "type": "integer" },
          "minItems": 1
        }
      }
    },
    "parameter_space": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1
      }
    },
    "target": {
      "type": "object",
      "required": ["host_label", "execution_mode"],
      "properties": {
        "host_label": { "type": "string", "minLength": 1 },
        "execution_mode": { "type": "string", "enum": ["dry-run"] }
      }
    },
    "metadata": { "type": "object" }
  }
}
